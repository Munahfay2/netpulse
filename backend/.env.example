# --- Database ---
# For the hackathon demo this defaults to a local SQLite file, so nothing
# needs to be configured to run NetPulse. To use Supabase/Postgres instead,
# set DATABASE_URL, e.g.:
# DATABASE_URL=postgresql+psycopg2://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./netpulse.db

# --- Supabase (optional, for production auth / realtime) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Africa's Talking ---
# Leave these blank to run in Demo SMS Mode (simulated, clearly labelled).
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=NetPulse

# --- App ---
DEMO_MODE=true
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Simulator ---
TELEMETRY_INTERVAL_SECONDS=5
