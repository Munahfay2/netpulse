# Base URL the frontend calls for the API. In local dev, Vite's dev server
# proxies /api to the backend (see vite.config.ts), so this can stay unset.
# When deploying the frontend separately (e.g. Vercel) from the backend
# (e.g. Render/Railway/Fly.io), set this to the deployed backend URL and
# update src/api/client.ts's BASE if you switch away from a relative "/api".
VITE_API_URL=http://localhost:8000
